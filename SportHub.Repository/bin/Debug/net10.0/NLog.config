<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      autoReload="true"
      throwConfigExceptions="true">

	<variable name="logDirectory" value="${basedir}/Logs" />

	<targets>
		<target xsi:type="File" name="Default"
				fileName="${logDirectory}/Info/${date:format=yyyyMMddHH}.txt"
				layout="${longdate} ${logger}: ${message}${newline}${when:when='${aspnet-request-ip}'!='':inner=${aspnet-request-ip}}${when:when='${aspnet-request-url}'!='':inner= - ${aspnet-request-url}}${when:when='${aspnet-request-querystring}'!='':inner= - ${aspnet-request-querystring}}${when:when='${aspnet-request-posted-body}'!='':inner= - ${aspnet-request-posted-body}}${newline}${when:when='${exception}'!='':inner=${exception:format=tostring}${newline}}"
				maxArchiveFiles="64"
				archiveAboveSize="8388608"
				createDirs="true" />

		<target xsi:type="File" name="Error"
				fileName="${logDirectory}/Error/${date:format=yyyyMMddHH}.txt"
				layout="${longdate} ${logger}: ${message}${newline}${when:when='${aspnet-request-ip}'!='':inner=${aspnet-request-ip}}${when:when='${aspnet-request-url}'!='':inner= - ${aspnet-request-url}}${when:when='${aspnet-request-querystring}'!='':inner= - ${aspnet-request-querystring}}${when:when='${aspnet-request-posted-body}'!='':inner= - ${aspnet-request-posted-body}}${newline}${when:when='${exception}'!='':inner=${exception:format=tostring}${newline}}"
				maxArchiveFiles="64"
				archiveAboveSize="8388608"
				createDirs="true" />

		<target xsi:type="File" name="Custom"
				fileName="${logDirectory}/${when:when='length(${event-properties:item=EventId_Name})>0':inner=${event-properties:item=EventId_Name}:else=${event-properties:item=EventName}}/${date:format=yyyyMMddHH}.txt"
				layout="${longdate} ${logger}: ${message}${newline}${when:when='${aspnet-request-ip}'!='':inner=${aspnet-request-ip}}${when:when='${aspnet-request-url}'!='':inner= - ${aspnet-request-url}}${when:when='${aspnet-request-querystring}'!='':inner= - ${aspnet-request-querystring}}${when:when='${aspnet-request-posted-body}'!='':inner=${aspnet-request-posted-body}}${newline}${when:when='${exception}'!='':inner=${exception:format=tostring}${newline}}"
				maxArchiveFiles="64"
				archiveAboveSize="8388608"
				createDirs="true" />
	</targets>

	<rules>
		<logger name="Microsoft*" finalMinLevel="Warn" />
		<logger name="Microsoft.Hosting.Lifetime" finalMinLevel="Info" />

		<logger name="*" minlevel="Info" writeTo="Custom">
			<filters defaultAction="Ignore">
				<when condition="('${event-properties:item=EventId_Id}'=='-65535' or '${event-properties:item=EventId}'=='-65535') and (length('${event-properties:item=EventId_Name}')>0 or length('${event-properties:item=EventName}')>0)" action="LogFinal" />
			</filters>
		</logger>

		<logger name="*" minlevel="Error" writeTo="Error">
			<filters defaultAction="LogFinal">
				<when condition="('${event-properties:item=EventId_Id}'=='-65535' or '${event-properties:item=EventId}'=='-65535') and (length('${event-properties:item=EventId_Name}')>0 or length('${event-properties:item=EventName}')>0)" action="Ignore" />
			</filters>
		</logger>

		<logger name="*" minlevel="Info" writeTo="Default">
			<filters defaultAction="LogFinal">
				<when condition="('${event-properties:item=EventId_Id}'=='-65535' or '${event-properties:item=EventId}'=='-65535') and (length('${event-properties:item=EventId_Name}')>0 or length('${event-properties:item=EventName}')>0)" action="Ignore" />
			</filters>
		</logger>
	</rules>
</nlog>